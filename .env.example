NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cosmetic_web

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRE=30d

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@cosmeticweb.com

# AWS SES via Lambda (recommended for production)
SES_LAMBDA_URL=
SES_LAMBDA_API_KEY=
SES_FROM_EMAIL=noreply@yourdomain.com

# MSG91 OTP — disabled in code (see services/smsService.js). Uncomment vars when re-enabled.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_COUNTRY_CODE=91
# MSG91_OTP_EXPIRY_MINUTES=10

# Frontend URL (for CORS) — set to your live storefront origin (no trailing slash)
FRONTEND_URL=http://localhost:3000
# Extra origins (comma-separated), e.g. http://192.168.1.10:3000 or https://yourdomain.com
ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
ALLOW_VERCEL_PREVIEW=false
ALLOW_ALL_ORIGINS=false
# When true (default), any https:// origin may call the API. Set false to only allow FRONTEND_URL + ALLOWED_ORIGINS (+ Vercel hosts).
ALLOW_HTTPS_ORIGINS=true

# Admin
ADMIN_EMAIL=admin@cosmeticweb.com
STATIC_ADMIN_EMAILS=admin2@cosmeticweb.com
